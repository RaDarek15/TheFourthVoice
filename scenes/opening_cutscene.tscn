[sub_resource type="Shader" id="Shader_vignette"]
code = "shader_type canvas_item;

void fragment() {
	vec2 p = (UV - vec2(0.5, 0.48)) * vec2(1.0, 0.85);
	float shade = smoothstep(0.20, 0.66, length(p));
	COLOR = vec4(0.012, 0.018, 0.022, shade * 0.58);
}
"

